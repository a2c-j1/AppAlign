# Conservative baseline: enforce stable whitespace without rewriting code structure.
--swift-version 6.0
--rules linebreaks,consecutiveBlankLines,consecutiveSpaces,spaceAroundBraces,spaceAroundOperators,spaceAroundParens,spaceInsideBrackets,spaceInsideGenerics,spaceInsideParens,trailingSpace
--exclude .build,DerivedData
